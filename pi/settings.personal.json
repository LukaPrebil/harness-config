{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-ollama-cloud",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system@44.0.1",
    "npm:pi-mcp-adapter@7.0.1",
    "npm:pi-intercom@0.19.0",
    "npm:pi-web-access"
  ],
  "defaultProvider": "ollama-cloud",
  "defaultModel": "deepseek-v4.1-flash:1017",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      "~/.pi-personal/agent/extensions/hook-bridge.ts"
    ],
    "agentOverrides": {
      "PR Reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Spec Verifier": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash"
        ]
      },
      "Cybersecurity Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "GDPR Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Product Manager": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "UX Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Doc Reader": {
        "tools": [
          "read"
        ]
      }
    }
  },
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "skills": [
    "!skills/synced/44fc44fd-*/**",
    "!skills/synced/a141ca0a-*/**"
  ],
  "notices": {
    "cacheMisses": true,
    "cacheWarming": true,
    "compactionCosts": true,
    "reasoningDrops": true
  }
}
