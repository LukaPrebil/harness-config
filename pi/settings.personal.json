{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-ollama-cloud",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system@33.0.5",
    "npm:pi-mcp-adapter@3.3.0",
    "npm:pi-intercom@^0.13.0",
    "npm:pi-web-access"
  ],
  "defaultProvider": "ollama-cloud",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "-builtin:mcp"
  ]
}
