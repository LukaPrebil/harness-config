{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-ollama-cloud",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system@37.0.0",
    "npm:pi-mcp-adapter@5.0.0",
    "npm:pi-intercom@0.16.0",
    "npm:pi-web-access"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      "~/.pi/agent/extensions/hook-bridge.ts"
    ]
  },
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "skills": [
    "!skills/synced/588e67cb-*/**",
    "!skills/synced/a141ca0a-*/**"
  ]
}
