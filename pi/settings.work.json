{
  "theme": "dark",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-ollama-cloud",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system@42.0.0",
    "npm:pi-mcp-adapter@7.0.0",
    "npm:pi-intercom@0.18.1",
    "npm:pi-web-access"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      "~/.pi/agent/extensions/hook-bridge.ts"
    ],
    "agentOverrides": {
      "PR Reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Spec Verifier": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash"
        ]
      },
      "Cybersecurity Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "GDPR Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Product Manager": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "UX Expert": {
        "tools": [
          "read",
          "grep",
          "find",
          "bash",
          "web_search",
          "fetch_content"
        ]
      },
      "Doc Reader": {
        "tools": [
          "read"
        ]
      }
    }
  },
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "skills": [
    "!skills/synced/588e67cb-*/**",
    "!skills/synced/a141ca0a-*/**"
  ]
}
