#!/bin/sh
# Single source of truth for which account a directory belongs to. The pi shim
# and the claude() wrapper in ~/.zsh_exports both call this, so adding a work
# root is a one-line change in one file.
#
# Expects an absolute path; defaults to the current directory.

target=${1:-$PWD}

# The trailing slash on both sides stops ~/code/awesome from matching the
# ~/code/aw work root.
case "$target/" in
	"$HOME/code/aw/"* | "$HOME/code/work/"*) echo work ;;
	*) echo personal ;;
esac
